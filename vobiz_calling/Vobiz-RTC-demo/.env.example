# Copy this file to .env (same folder) and fill it in. .env is git-ignored: never commit it.
# Every value below is a placeholder.

# ─── Server ──────────────────────────────────────────────────────────────────

# Port the server listens on. Point your tunnel (ngrok, cloudflared) at it.
PORT=3000

# This server's public HTTPS address, exactly as Vobiz calls it, with no trailing slash,
# e.g. https://abc123.ngrok-free.app. Used to check Vobiz's webhook signatures and to build
# the transfer URL.
PUBLIC_URL=https://<your-public-url>

# ─── Calls ───────────────────────────────────────────────────────────────────

# A number on your Vobiz account, in E.164. Shown as the caller ID on calls the app makes
# to phones, and on the app's leg of calls to your number: Vobiz rings an app only with one
# of your numbers there. The app shows the real caller, which the server passes in a header.
CALLER_ID=+<your-vobiz-number>

# Who a call to your Vobiz number rings: the SIP user the app signs in as. Several,
# comma separated, ring at the same time (the first to answer gets the call).
#   SIP endpoint sign-in:  sip:<endpoint-username>@registrar.vobiz.ai
#   Access-token sign-in:  sip:<identity>_<VOBIZ_AUTH_ID>@registrar.vobiz.ai
SIP_ENDPOINT=sip:<your-endpoint-username>@registrar.vobiz.ai

# Optional
#DEFAULT_COUNTRY_CODE=91      added to 10-digit numbers the app dials
#RING_SECONDS=45              how long a call to your number rings the app
#DEFAULT_DESTINATION=         number dialled when a call from the app names none

# ─── Vobiz API (Console → dashboard: Auth ID and Auth Token) ─────────────────
# Needed for access tokens, push registration, transfer and webhook signatures.
# The Auth Token is your account's API key: it stays on this server, never in the app.

VOBIZ_AUTH_ID=<your-auth-id>
VOBIZ_AUTH_TOKEN=<your-auth-token>

# ─── The app's routes (/token, /push/devices/*, /calls/transfer) ─────────────

# A long random string. The app sends it as X-App-Key (build it with
# --dart-define=VOBIZ_APP_KEY=<the same value>). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# It only keeps strangers off this demo server: it ships inside the app, so in
# production put your own user sign-in in front of these routes instead.
APP_KEY=<a-long-random-string>

# Access tokens: the ID of the Vobiz application (Console → Applications) whose Answer
# URL handles calls from token-signed-in apps. Tokens last JWT_TTL_SECONDS (180 to 86400)
# and the SDK renews them before they expire.
JWT_APP_ID=<your-application-id>
#JWT_TTL_SECONDS=3600
#TOKEN_IDENTITIES=alice,bob   only these identities may get a token (recommended)

# Local experiments only: accept webhooks without a valid Vobiz signature.
#ALLOW_UNSIGNED_WEBHOOKS=false
