# ─── Required ────────────────────────────────────────────────────────────────

# The Vobiz phone number purchased from the Vobiz console (E.164 format).
CALLER_ID=+<your-vobiz-number>

# SIP endpoint URI (Vobiz Console > Voice > Endpoints)
SIP_ENDPOINT=sip:your-endpoint-username@registrar.vobiz.ai

# ─── Optional ─────────────────────────────────────────────────────────────────

# Fallback PSTN destination for outbound calls when the app hasn't POST /call'd.
DEFAULT_DESTINATION=+<your-test-destination>

# Default country code used when formatting 10-digit numbers.
DEFAULT_COUNTRY_CODE=91

# ─── Hold Announcement (required to play "on hold" message to PSTN caller) ───
#
# How to get these:
#   1. Log in to app.vobiz.ai
#   2. Go to Settings → API Keys (or Developers → Credentials)
#   3. Copy Account SID and Auth Token
#
VOBIZ_ACCOUNT_SID=<your-vobiz-account-sid>
VOBIZ_AUTH_TOKEN=<your-vobiz-auth-token>

# Your publicly reachable HTTPS URL (e.g. from ngrok).
# The backend registers this as the conference status + hold announcement URL.
# Example: https://abc123.ngrok-free.app
PUBLIC_URL=https://<your-ngrok-url>
